#======================================================================================
#
# OpenWrt-X96MaxPlus-N1  -  Image Builder custom package list
#
# Format: CONFIG_PACKAGE_<name>=y     -> package WILL be installed
#
# PHASE 1 = minimal bootable firmware.
#   OpenWrt + LuCI + SSH + network + USB + storage + basic tools.
#
# IMPORTANT: every package below was verified against the REAL OpenWrt 25.12.5
#            package index (aarch64_generic) + armsr/armv8 kmods feed.
#            Do NOT add package names from memory - they must exist in the index.
#
# NOTE:
#   - Amlogic SoC drivers (meson*, ir) are built INTO the OPHUB kernel, not modules.
#   - luci-app-amlogic is downloaded separately (OPHUB release) in imagebuilder.sh.
#   - Third-party themes/apps (argon, diskman, bluetooth) are NOT in the official
#     feed -> they are Phase 2 (via OPHUB/third-party feeds), not Phase 1.
#
#======================================================================================

# ---- SSH / terminal ----
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_dropbear=y

# ---- LuCI essentials (HTTPS / ttyd / file manager / commands) ----
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# ---- network diagnostics / system monitor ----
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_luci-i18n-vnstat2-zh-cn=y

# ---- disk / storage management ----
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y

# ---- filesystem tools (USB / external disks) ----
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-fs-f2fs=y

# ---- USB support ----
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-acm=y

# ---- WiFi drivers ----
# X96 Max+ : RTL8822CS  -> kmod-rtw88-8822cs (+ rtw88-sdio)
# N1       : BCM43455   -> kmod-brcmfmac
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_PACKAGE_kmod-brcmutil=y
CONFIG_PACKAGE_kmod-rtw88=y
CONFIG_PACKAGE_kmod-rtw88-8822cs=y
CONFIG_PACKAGE_kmod-rtw88-sdio=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

# ---- Bluetooth ----
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_kmod-btusb=y

# ---- basic shell utilities ----
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# ---- zoneinfo (CN) ----
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_zoneinfo-core=y

# ---- Docker (统一使用 dockerman 界面 + 官方中文包 + 完整运行时) ----
# 说明: ImageBuilder 走官方 feed, 不存在旧冲突包 luci-app-docker, 故只需装 dockerman。
# dockerd 依赖 containerd/runc, 缺失会导致 docker 启动异常 (bbolt 损坏/SIGBUS)。
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
