#!/bin/sh
#======================================================================================
# OpenWrt-X96MaxPlus-N1  -  first-boot tweaks
# Executed once on first boot via /etc/uci-defaults
#======================================================================================

# Basic uhttpd / LuCI hardening-friendly defaults
uci -q batch <<-EOF
	set uhttpd.main.redirect_https='0'
	set luci.main.lang='zh_cn'
	set luci.main.mediaurlbase='/luci-static/argon'
	set luci.themes.Argon='/luci-static/argon'
	commit uhttpd
	commit luci
EOF

# ttyd: shell without login prompt, restart on exit
uci -q batch <<-EOF
	set ttyd.@ttyd[0].command='/bin/login -f root'
	set ttyd.@ttyd[0].interface='@lan'
	commit ttyd
EOF

# Docker data-root: 仅在目录不存在时创建, 绝不执行任何分区/格式化操作。
# 数据目录固定为固件根分区内的 /opt/docker, 不依赖外接 U 盘, 避免无盘启动时初始化失败。
mkdir -p /opt/docker
uci -q batch <<-EOF
	set docker.@globals[0].data_root='/opt/docker'
	commit docker
EOF

exit 0
