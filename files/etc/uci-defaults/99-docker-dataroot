#!/bin/sh
#======================================================================================
# OpenWrt-X96MaxPlus-N1  -  Docker data-root 初始化 (first boot, 幂等, 非破坏)
# Executed once on first boot via /etc/uci-defaults
#
# 设计原则:
#   - 仅创建目录, 绝不执行任何分区(fdisk/parted)或格式化(mkfs)操作
#   - 不依赖外接 U 盘; 无外置存储时使用根分区内的 /opt/docker
#   - 若已存在可用数据目录则跳过
#======================================================================================

DATA_ROOT="/opt/docker"

# 仅在目录不存在时创建 (幂等)
[ -d "${DATA_ROOT}" ] || mkdir -p "${DATA_ROOT}"

# 写入 uci (dockerman / docker 服务读取), 失败不阻塞启动
uci -q batch <<-EOF
	set docker.@globals[0]=globals
	set docker.@globals[0].data_root='${DATA_ROOT}'
	commit docker
EOF

exit 0
